        }, {
          "path": "/System/Library/Frameworks/SwiftUI.framework",
          "target-membership": [
            "HowLongLeftWidgetsExtension/frameworks",
            "HowLongLeftComplicationsExtension/frameworks",
          ],
        },
      ],
    }, {
